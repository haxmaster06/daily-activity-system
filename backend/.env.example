APP_NAME=DAMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:13002

# Bahasa Indonesia — dipakai Carbon translatedFormat dan pesan validasi
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database khusus DAMS. Server MySQL ini dipakai bersama project lain —
# jangan pernah menunjuk ke database milik project lain.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dams_db
DB_USERNAME=root
DB_PASSWORD=

# Database test terpisah. Tidak boleh menunjuk ke DB_DATABASE.
DB_TEST_DATABASE=dams_db_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="dams@hbmcorp.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Next.js — dipakai untuk CORS dan tautan pada email
FRONTEND_URL=http://localhost:13001

# Keluar otomatis DIMATIKAN. Sesi berlaku sampai pengguna menekan Keluar.
# Diisi 720, sesi kembali berakhir setelah 720 menit TANPA AKTIVITAS —
# bukan sejak masuk; selama aplikasi dipakai masa berlakunya digeser terus.
DAMS_SESI_MENIT=0

# Dipakai bila pengguna mencentang "Ingat saya". 0 = tanpa batas.
DAMS_SESI_MENIT_DIINGAT=0

# Jumlah perangkat yang boleh dipakai bersamaan oleh satu akun. 0 = tanpa batas.
# Diisi angka, token tertua dibuang saat batasnya terlampaui — dan itu
# mengeluarkan orang yang mungkin sedang bekerja.
DAMS_SESI_MAKSIMAL_PERANGKAT=0

# Reverb - server WebSocket untuk notifikasi seketika.
# Port 13003 melanjutkan rentang port DAMS (13001 frontend, 13002 API).
# REVERB_APP_SECRET wajib diganti di server.
REVERB_APP_ID=dams
REVERB_APP_KEY=ganti-dengan-kunci-acak
REVERB_APP_SECRET=ganti-dengan-rahasia-acak
REVERB_HOST=127.0.0.1
REVERB_PORT=13003
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=13003
