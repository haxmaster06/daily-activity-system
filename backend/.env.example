APP_NAME=DAMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:13002

# Bahasa Indonesia — dipakai Carbon translatedFormat dan pesan validasi
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database khusus DAMS. Server MySQL ini dipakai bersama project lain —
# jangan pernah menunjuk ke database milik project lain.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dams_db
DB_USERNAME=root
DB_PASSWORD=

# Database test terpisah. Tidak boleh menunjuk ke DB_DATABASE.
DB_TEST_DATABASE=dams_db_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="dams@hbmcorp.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Next.js — dipakai untuk CORS dan tautan pada email
FRONTEND_URL=http://localhost:13001

# Sesi berakhir setelah sekian menit TANPA AKTIVITAS, bukan sejak masuk.
# Selama aplikasi dipakai, masa berlakunya digeser terus.
DAMS_SESI_MENIT=720

# Dipakai bila pengguna mencentang "Ingat saya" (7 hari)
DAMS_SESI_MENIT_DIINGAT=10080

# Jumlah perangkat yang boleh dipakai bersamaan oleh satu akun.
# Melebihi batas, token tertua yang dibuang.
DAMS_SESI_MAKSIMAL_PERANGKAT=5
