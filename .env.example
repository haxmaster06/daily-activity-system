# Variabel deployment Docker Compose.
# Salin menjadi `.env` di root repo, lalu isi nilainya. Berkas `.env` tidak
# pernah di-commit (non-fungsional §10).
#
# Dua fase yang direncanakan:
#
#   QA          http://36.92.42.135:13001   (IP publik, tanpa TLS)
#   Production  https://daily.hbmnet.co.id  (subdomain, TLS di proxy)
#
# Nilai di bawah ditulis untuk fase QA. Baris yang perlu diubah saat naik ke
# production ditandai "PRODUCTION:".
#
# 13001 adalah SATU-SATUNYA port yang terbuka ke luar. Yang mendengarkannya
# adalah layanan `proxy`, bukan Next.js langsung — WebSocket Reverb harus
# berbagi alamat yang sama agar tidak ada port kedua yang perlu dibuka di
# firewall. Backend, Reverb, MySQL, dan Redis diikat ke 127.0.0.1.

APP_NAME=DAMS
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# PRODUCTION: https://daily.hbmnet.co.id
APP_URL=http://36.92.42.135:13001
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# Database — kredensial diisi saat deployment, bukan di repo
DB_CONNECTION=mysql
DB_DATABASE=dams_db
DB_USERNAME=dams
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=phpredis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Penyimpanan berkas unggahan
# ---------------------------------------------------------------------------
#
# Lampiran laporan, foto profil, berkas export, dan cadangan basis data
# disimpan di HOST, di luar wilayah Docker — bukan di named volume.
#
# Named volume lenyap bersama `docker volume prune` yang dijalankan orang lain,
# dan tidak ikut tersalin oleh pencadangan server. Lampiran laporan tidak dapat
# dibuat ulang dari mana pun.
#
# Direktorinya wajib dapat ditulis uid 82 (www-data pada image Alpine). Sekali
# saja, di server:
#
#     sudo mkdir -p /mnt/raw-backup/app_data_storage/hbm-daily-activity/{storage-app,backup}
#     sudo chown -R 82:82 /mnt/raw-backup/app_data_storage/hbm-daily-activity
#
DAMS_STORAGE_PATH=/mnt/raw-backup/app_data_storage/hbm-daily-activity

# Folder cadangan DI DALAM container. Dipetakan ke
# `${DAMS_STORAGE_PATH}/backup` oleh docker-compose.yml — jangan diisi jalur
# host di sini, sebab yang membacanya adalah proses di dalam container.
DAMS_BACKUP_FOLDER=/var/backup/dams

# Origin frontend yang diizinkan memanggil API (config/cors.php).
#
# Berlapis, bukan syarat agar aplikasi jalan: peramban tidak pernah memanggil
# backend lintas origin — seluruhnya lewat Route Handler Next.js di origin yang
# sama, lalu diteruskan server-ke-server. Diisi tepat satu origin, tidak pernah
# '*', sesuai non-fungsional §6.
#
# PRODUCTION: https://daily.hbmnet.co.id
FRONTEND_URL=http://36.92.42.135:13001

# Flag `secure` pada cookie token.
#
# Peramban menolak menyimpan cookie ber-flag Secure di atas http polos, dan
# menolaknya tanpa suara — login membalas 200, lalu tiap halaman melempar balik
# ke halaman masuk. Selama fase QA dilayani http, nilainya wajib false.
#
# Dibaca saat container berjalan, jadi cukup restart tanpa build ulang.
#
# PRODUCTION: true
DAMS_COOKIE_SECURE=false

# Keluar otomatis DIMATIKAN — 0 berarti tanpa batas pada ketiganya.
# Diisi angka, sesi kembali berakhir setelah sekian menit TANPA AKTIVITAS,
# bukan sejak masuk.
DAMS_SESI_MENIT=0
DAMS_SESI_MENIT_DIINGAT=0
DAMS_SESI_MAKSIMAL_PERANGKAT=0

# Akun administrator awal. Seeder MENOLAK berjalan di production tanpa
# DAMS_ADMIN_PASSWORD — kata sandi tidak pernah ditanam di kode.
# Ganti kata sandinya lewat aplikasi setelah masuk pertama kali.
DAMS_ADMIN_EMAIL=
DAMS_ADMIN_PASSWORD=
DAMS_ADMIN_NAME=Administrator DAMS

# Alamat yang dilewati PenggunaSeeder saat mengimpor daftar pengguna dari berkas
# rujukan, dipisah koma. Bergantung pemasangan — administrator bawaan, dan
# alamat yang sudah dipakai akun lain sehingga bentrok dengan kolom email unik.
DAMS_PENGGUNA_DILEWATI=

# Jumlah proses PHP-FPM. Yang membatasi RAM, bukan core: tiap proses menahan
# satu aplikasi Laravel penuh, sekitar 40-80 MB.
PHP_FPM_MAX_CHILDREN=8

# ---------------------------------------------------------------------------
# Reverb — WebSocket notifikasi seketika
# ---------------------------------------------------------------------------
#
# APP_KEY dan APP_SECRET wajib diganti dengan nilai acak. Yang memegang secret
# dapat menyiarkan ke channel mana pun.
#
#     openssl rand -hex 16
#
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=dams
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Alamat yang dipakai PERAMBAN. Ditanam ke bundel frontend saat build, jadi
# mengubahnya menuntut `docker compose build frontend`, bukan sekadar restart.
#
# Lewat pintu yang sama dengan aplikasinya, sehingga portnya port pintu —
# bukan 13003. Port 13003 hanya terbuka di 127.0.0.1 untuk pemeriksaan langsung
# dari dalam server.
#
# PRODUCTION: REVERB_PUBLIC_HOST=daily.hbmnet.co.id
#             REVERB_PUBLIC_PORT=443
#             REVERB_PUBLIC_SCHEME=https
REVERB_PUBLIC_HOST=36.92.42.135
REVERB_PUBLIC_PORT=13001
REVERB_PUBLIC_SCHEME=http

# Alamat Reverb di dalam jaringan Docker diatur langsung di docker-compose.yml
# (REVERB_HOST=reverb). Tidak perlu diisi di sini.
